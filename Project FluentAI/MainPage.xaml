<Page
    x:Class="Project_FluentAI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Project_FluentAI"
    xmlns:models="using:Project_FluentAI.Models"
    xmlns:helpers="using:Project_FluentAI.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar / Drag Region -->
        <Grid x:Name="AppTitleBar" Background="Transparent" Height="32" VerticalAlignment="Top" Canvas.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="AppTitle" Text="FluentAI" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed"/>
        </Grid>

        <SplitView Grid.RowSpan="2" x:Name="ShellSplitView"
                   DisplayMode="Inline"
                   IsPaneOpen="True"
                   OpenPaneLength="300"
                   CompactPaneLength="0"
                   PaneBackground="Transparent">

            <SplitView.Pane>
                <Grid x:Name="SidebarRoot" Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}">
                    <Grid.RowDefinitions>
                        <!-- Hamburger Menu Area -->
                        <RowDefinition Height="Auto"/>
                        <!-- New Chat button -->
                        <RowDefinition Height="Auto"/>
                        <!-- Search box -->
                        <RowDefinition Height="Auto"/>
                        <!-- "Chats" section header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Scrollable chat list -->
                        <RowDefinition Height="*"/>
                        <!-- Settings footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Hamburger Button (Top Left) -->
                    <Button x:Name="HamburgerButton"
                            Content="&#xE700;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Width="48" Height="48"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BackButton_Click"
                            Margin="4,4,0,0"/>

                    <!-- New Chat Button -->
                    <Button Grid.Row="1"
                            x:Name="NewChatButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="NewChatButton_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,12">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE710;" FontSize="16" Margin="4,0,12,0"/>
                            <TextBlock Text="New Chat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Search Box -->
                    <AutoSuggestBox Grid.Row="2"
                                    x:Name="ChatSearchBox"
                                    PlaceholderText="Find a chat"
                                    QueryIcon="Find"
                                    Margin="16,0,16,24"
                                    HorizontalAlignment="Stretch"
                                    TextChanged="ChatSearchBox_TextChanged"/>

                    <!-- Chats Section Header -->
                    <TextBlock Grid.Row="3"
                               x:Name="ChatsHeader"
                               Text="Chats"
                               Style="{StaticResource BaseTextBlockStyle}"
                               FontWeight="SemiBold"
                               Margin="16,0,0,8"
                               FontSize="14"/>

                    <!-- Scrollable chat list -->
                    <ListView Grid.Row="4"
                              x:Name="ChatListView"
                              ItemsSource="{x:Bind ViewModel.Chats, Mode=OneWay}"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource SidebarListViewItemStyle}"
                              SelectionChanged="ChatListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatItem">
                                <Grid Background="Transparent" Padding="4,8"
                                      RightTapped="ChatItem_RightTapped"
                                      Holding="ChatItem_Holding">
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon Glyph="&#xE8BD;"
                                                  FontSize="16"
                                                  Margin="0,0,12,0"
                                                  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Small pin indicator -->
                                        <FontIcon Glyph="&#xE840;"
                                                  FontSize="11"
                                                  Margin="8,0,0,0"
                                                  Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                                  Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Rectangle
            Grid.Row="0"
            Grid.RowSpan="6"
            Width="1"
            HorizontalAlignment="Right"
            Fill="#33FFFFFF"/>

                    <!-- Settings Footer Area -->
                    <Grid Grid.Row="5" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Accent line for Settings -->
                        <Rectangle x:Name="SettingsAccentIndicator"
                                   Width="3" Height="24" 
                                   Fill="{ThemeResource SystemControlHighlightAccentBrush}" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,0"
                                   Visibility="Collapsed"/>
                        
                        <Button Grid.Column="1"
                                x:Name="SettingsButton"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="SettingsButton_Click"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE713;" FontSize="16" Margin="4,0,12,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="BackButton"
                            Content="&#xE72B;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Width="48" Height="48"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BackButton_Click"
                            HorizontalAlignment="Left"
                            Margin="4,4,0,0"
                            Visibility="Collapsed"/>
                    <Frame Grid.Row="1" x:Name="ContentFrame"/>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
