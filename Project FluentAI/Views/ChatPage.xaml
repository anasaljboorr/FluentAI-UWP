<Page
    x:Class="Project_FluentAI.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Project_FluentAI.Models"
    xmlns:helpers="using:Project_FluentAI.Helpers"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Page.Resources>
        <helpers:UserToAlignmentConverter x:Key="UserToAlignmentConverter"/>
        <helpers:UserToBackgroundConverter x:Key="UserToBackgroundConverter"/>
        <helpers:UserToForegroundConverter x:Key="UserToForegroundConverter"/>

        <DataTemplate x:Key="MessageTemplate" x:DataType="models:Message">
            <!-- Grid with transparent background ensures the entire message row/area can catch right-clicks -->
            <Grid Margin="0,4,0,12" 
                  Background="Transparent"
                  HorizontalAlignment="{x:Bind IsUser, Converter={StaticResource UserToAlignmentConverter}}"
                  RightTapped="Message_RightTapped"
                  Holding="Message_Holding">
                <Border Background="{x:Bind IsUser, Converter={StaticResource UserToBackgroundConverter}}"
                        CornerRadius="4" Padding="12,8" MaxWidth="500">
                    <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{x:Bind IsUser, Converter={StaticResource UserToForegroundConverter}}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Root grid hosts both the empty state and the chat UI.
         Only one is visible at a time; toggled in code-behind via OnNavigatedTo. -->
    <Grid x:Name="RootGrid">

        <!-- ═══════════════════════════════════════════════════════════════════
             EMPTY STATE  –  shown when no conversation is selected
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="EmptyStatePanel"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Native Fluent Design chat icon (Segoe MDL2 Assets / Fluent Icons)
                     - Glyph &#xE8BD; is the standard 'Message' icon
                     - Size: 80px
                     - Opacity: 50%
                     - Margin: 12px bottom + 12px StackPanel spacing = 24px spacing to title -->
                <FontIcon Glyph="&#xE8BD;"
                          FontSize="80"
                          Opacity="0.5"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,12"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                <!-- Primary title -->
                <TextBlock Text="Select a conversation"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                <!-- Subtitle -->
                <TextBlock Text="Start a new conversation from the sidebar."
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                <!-- Secondary hint -->
                <TextBlock Text="Or click + New Chat to begin."
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                           Margin="0,4,0,0"/>

            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             CHAT UI  –  shown when a conversation is selected
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ChatPanel"
              Visibility="Collapsed"
              Margin="0,32,0,0">

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="641"/>
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ChatPanel.Margin" Value="0,20,0,0"/>
                            <Setter Target="ChatTitle.Margin" Value="16,0,16,16"/>
                            <Setter Target="ChatTitle.FontSize" Value="24"/>
                            <Setter Target="MessageListView.Margin" Value="16,0,16,0"/>
                            <Setter Target="InputArea.Margin" Value="0,16,0,0"/>
                            <Setter Target="InputBox.Margin" Value="8,0,8,0"/>
                            <Setter Target="SendButton.Padding" Value="16,4,16,6"/>
                            <Setter Target="SendButton.Width" Value="70"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ChatTitle"
                       Text=""
                       FontSize="28"
                       FontWeight="Light"
                       Margin="40,0,40,32"/>

            <ListView Grid.Row="1" x:Name="MessageListView"
                      SelectionMode="None"
                      Margin="40,0,40,0"
                      ItemTemplate="{StaticResource MessageTemplate}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Cortana-style Unified Input Bar -->
            <Grid x:Name="InputArea" Grid.Row="2" Margin="0,24,0,0" Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Background for the bar -->
                <Border x:Name="InputBarBackground" Grid.ColumnSpan="2" 
                        Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"/>

                <!-- Main Input Box (Edge to edge within the bar) -->
                <TextBox x:Name="InputBox" 
                         Grid.Column="0"
                         PlaceholderText="Ask me anything"
                         Style="{StaticResource CortanaTextBoxStyle}"
                         VerticalAlignment="Center"
                         Margin="12,0,12,0"
                         AcceptsReturn="False"/>

                <!-- Send Button (Accent Color) -->
                <Button x:Name="SendButton" 
                        Grid.Column="1"
                        Width="48" Height="48"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource SidebarButtonStyle}"
                        Background="{ThemeResource SystemControlHighlightAccentBrush}"
                        Click="SendButton_Click">
                    <FontIcon Glyph="&#xE724;" 
                              FontSize="18" 
                              Foreground="White"/>
                </Button>
            </Grid>
        </Grid>

    </Grid>
</Page>
